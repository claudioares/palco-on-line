---
import Layout from "../layouts/Layout.astro";
import InputComponentReact from "../components/input/Input";
import VideoCards from "../components/videoCards/VideoCards.astro";
import "../../app/globals.css";
---

<script>
  document.getElementById("iconToggleNav")?.addEventListener("click", () => {
    const navBar = document.getElementById("navBarContent");

    navBar?.classList.toggle("lg:w-[28%]");
    navBar?.classList.toggle("lg:w-0");
    navBar?.classList.toggle("lg:px-1");
    navBar?.classList.toggle("lg:px-0");
    navBar?.classList.toggle("opacity-0");
    navBar?.classList.toggle("opacity-100");
  });
</script>
<Layout title="Login">
  <main class="flex w-full h-screen gap-4 pt-32 px-8 py-6">
    <!-- backgrouds -->
    <div
      class="w-full h-full bg-bg-logo bg-center bg-contain opacity-[12.5%] fixed top-0 left-0 z-[-1]"
    >
    </div>
    <div class="w-full h-full fixed bg-black opacity-70 top-0 left-0 z-[-1]">
    </div>
    <!-- backgrouds -->

    <div
      class={`
        w-[45%] h-full flex flex-col items-center justify-center gap-10 mb-auto
        max-lg:w-full
      `}
    >
      <h1 class="text-6xl max-lg:text-5xl text-white font-Dosis font-medium">
        Bem-vindo a sua <p class="text-red-600">música ao vivo</p>
      </h1>
      <div
        class="bg-slate-300 w-[25rem] h-auto py-14 flex flex-col items-center rounded-lg"
      >
        <div class="flex flex-col w-full h-full items-center justify-evenly">
          <h1 class="text-xl font-Dosis font-bold">Login</h1>
          <form class="flex gap-4 flex-col">
            <InputComponentReact
              placeholder="Digite seu email aquí"
              id="email"
            />
            <InputComponentReact
              placeholder="Digite sua senha aquí"
              id="password"
            />
          </form>
          <div>
            <span class="text-center text-sm">Ainda não tem cadastro?</span>
            <a
              href="/register"
              class="display-hidden text-red-600 hover:opacity-80"
              >Cadastre-se</a
            >
          </div>
        </div>
      </div>
    </div>
    <VideoCards />
  </main>
</Layout>
