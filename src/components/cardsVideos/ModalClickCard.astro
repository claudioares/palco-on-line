---
import { Image } from "astro:assets";
import { apiImagensCardVideos } from "../../API_simulation_to_test/API";
import InfoMusic from "./infoMusic";
---

<div
  class="hidden fixed top-0 w-full h-full py-10 px-10 overflow-hidden bg-black z-50"
>
  <div class="flex gap-1 w-full h-full">
    <div
      class="flex items-center justify-center w-[75%] h-full bg-zinc-900 rounded-r-lg"
    >
      Aqui serão meus videos ao vivo
    </div>
    <div
      class="flex flex-col justify-between w-[25%] h-full bg-zinc-900 bg-opacity-80 rounded-l-lg"
    >
      <div
        class="flex flex-col gap-2 w-full h-full overflow-y-auto font-Dosis py-2 px-4"
      >
        {
          apiImagensCardVideos.map((infoCard) => (
            <div class="relative flex justify-center items-center w-full h-auto bg-white rounded-lg hover:border">
              <div
                class={`absolute justify-center gap-1 items-center top-0 left-0 rounded-lg
                                w-full h-full cursor-pointer opacity-0
                                hover:flex hover:opacity-100 hover:bg-black hover:bg-opacity-65`}
              >
                <InfoMusic
                  musicName={infoCard.nameMusic}
                  composer={infoCard.composer}
                  interpreter={infoCard.interpreter}
                />
              </div>

              <div>
                <Image
                  src={infoCard.img}
                  alt="imagem de fundo do card"
                  class="text-black w-full h-full rounded-lg"
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>
