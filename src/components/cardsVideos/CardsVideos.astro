---
import { PlayCircleIcon } from "lucide-react";
import { playlistArr } from "../../API_simulation_to_test/API";
import { Image } from "astro:assets";
import InfoMusic from "./infoMusic";

const responseRespositorie = await playlistArr();
---

<div>
  <div
    class={`
        flex flex-wrap w-full h-auto gap-4 justify-center items-center
        max-md:flex-col
        `}
  >
    {
      responseRespositorie.map((infoCard: any, index: any) => (
        <div
          class={`
          w-[25%] h-72 flex flex-col gap-3 rounded-lg
          max-md:w-full max-md:px-4
          infocardvideos
          `}
          id={`${infoCard.snippet.description}`}
        >
          <div class="relative flex justify-center items-center w-full h-[61%] bg-white rounded-lg hover:border">
            <a
              class={`absolute gap-1 p-7 top-0 left-0 rounded-lg
              w-full h-full cursor-pointer opacity-0
              hover:flex hover:opacity-100 hover:bg-black hover:bg-opacity-65`}
              href={`/videos/${infoCard.snippet.title}?index=${infoCard.snippet.position}`}
            >
              <PlayCircleIcon />
            </a>

            <Image
              src={infoCard.snippet.thumbnails.high.url}
              alt="imagem de fundo do card"
              class="w-full h-full rounded-lg"
              inferSize={true}
            />
          </div>

          <InfoMusic
            musicName={infoCard.snippet.title}
            interpreter={infoCard.snippet.videoOwnerChannelTitle}
          />
        </div>
      ))
    }
  </div>
</div>
