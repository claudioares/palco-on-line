---
import video01 from "../../assets/videos (1).mp4";
import video02 from "../../assets/videos (2).mp4";
import video03 from "../../assets/videos (3).mp4";
import video04 from "../../assets/videos (4).mp4";
import video05 from "../../assets/videos (5).mp4";
---

<div
  class={`
    w-[50%] h-full flex flex-col items-center gap-2 py-4 pl-4 justify-center
    max-lg:hidden
  `}
>
  <h1 class="text-white text-xl flex gap-2">
    <a href="/register" class="text-red-600 hover:opacity-80 cursor-pointer"
      >Inscreva-se</a
    > e assista aos conteúdos ao vivo
  </h1>
  <div
    class="flex items-center justify-center py-1 gap-1 h-auto w-auto overflow-clip"
  >
    <video
      autoplay
      preload="none"
      loop
      muted
      width="310"
      height="230"
      class="rounded-lg object-cover object-center"
    >
      <source src={video01} type="video/mp4" />
    </video>
    <video
      autoplay
      preload="none"
      muted
      width="310"
      height="230"
      class="rounded-lg object-contain object-center"
    >
      <source src={video02} type="video/mp4" />
    </video>
  </div>

  <div
    class="flex items-center justify-center py-1 gap-1 h-auto w-auto overflow-clip"
  >
    <video
      autoplay
      preload="none"
      muted
      width="310"
      height="230"
      class="rounded-lg object-contain object-center"
    >
      <source src={video04} type="video/mp4" />
    </video>
    <video
      autoplay
      preload="none"
      muted
      loop
      width="310"
      height="230"
      class="rounded-lg object-contain object-center"
    >
      <source src={video03} type="video/mp4" />
    </video>
    <video
      autoplay
      preload="none"
      loop
      muted
      width="310"
      height="230"
      class="rounded-lg object-contain object-center"
    >
      <source src={video05} type="video/mp4" />
    </video>
  </div>
</div>
