---
import instagramIcon from "../../../public/instagram.png";
import facebookIcon from "../../../public/facebook.png";
import youtubeIcon from "../../../public/youtube.png";
import { Image } from "astro:assets";
---

<li class="flex justify-start items-center gap-6 h-full w-[50%] max-lg:hidden">
  <a href="" class="flex justify-center items-center hover:border-b-2 h-full">
    <Image src={instagramIcon} alt="logo do instagram" class="cursor-pointer" />
  </a>
  <a href="" class="flex justify-center items-center hover:border-b-2 h-full">
    <Image src={facebookIcon} alt="logo do instagram" class="cursor-pointer" />
  </a>
  <a href="" class="flex justify-center items-center hover:border-b-2 h-full">
    <Image src={youtubeIcon} alt="logo do instagram" class="cursor-pointer" />
  </a>
</li>
