---
import { Image } from "astro:assets";
import logo from "../../assets/palco.png";
import iconRec from "../../assets/icons/iconRec.png";
import SocialLinks from "../../components/socialLinks/SocialLinks.astro";
---

<script>
  document.getElementById("buttonNavMenu")?.addEventListener("click", () => {
    const navManu = document.getElementById("navManu");

    navManu?.classList.toggle("max-lg:max-h-0");
    navManu?.classList.toggle("max-lg:max-h-screen");
    navManu?.classList.toggle("opacity-0");
    navManu?.classList.toggle("opacity-100");
  });
  addEventListener("DOMContentLoaded", () => {
    const home = document.getElementById("menuHome");
    const videos = document.getElementById("menuVideos");
    const live = document.getElementById("menuLive");
    const divLive = document.getElementById("divLive");

    const pathName = window.location.pathname;

    if (pathName === "/") {
      home?.classList.toggle("text-red-600");
      home?.classList.toggle("hover:text-red-600");
      home?.classList.toggle("border-none");
    }
    if (pathName === "/videos") {
      videos?.classList.toggle("text-red-600");
      videos?.classList.toggle("hover:text-red-600");
      videos?.classList.toggle("border-none");
    }
    if (pathName === "/live") {
      live?.classList.toggle("text-red-600");
      live?.classList.toggle("hover:text-red-600");
      divLive?.classList.toggle("border-none");
    }
  });
</script>

<header
  class={`
    flex w-full h-20 bg-black px-36 top-0 opacity-70 z-auto fixed
    max-lg:opacity-100
  `}
>
  <button
    id="buttonNavMenu"
    class="fixed top-5 left-10 z-30 text-white bg-orange-700 w-32 h-10 rounded-lg lg:hidden"
    >Menu</button
  >
  <ul
    id="navManu"
    class={`
      flex flex-1 items-center gap-16 h-full text-white text-lg
      max-lg:fixed max-lg:z-20 max-lg:w-full max-lg:max-h-0 max-lg:bg-black left-0 max-lg:flex max-lg:flex-col max-lg:justify-center
      max-lg:opacity-90 max-lg:gap-10 max-lg:overflow-hidden max-lg:transition-all duration-1000 
    `}
  >
    <li
      class={`
      flex items-center justify-between w-[50%] h-full
      max-lg:flex-col max-lg:w-full max-lg:h-auto max-lg:gap-10
    `}
    >
      <a
        id="menuHome"
        class="hover:text-slate-200 h-full hover:border-b-2 box-border flex items-center justify-center"
        href="/">Home</a
      >
      <a
        id="menuVideos"
        class="hover:text-slate-200 h-full hover:border-b-2 box-border flex items-center justify-center"
        href="/videos">Videos</a
      >
      <div
        id="divLive"
        class="flex items-center justify-center gap-2 h-full cursor-pointer hover:border-b-2 hover:text-slate-200 box-border"
      >
        <a
          id="menuLive"
          class="h-full flex items-center justify-center"
          href="/live">Ao vivo</a
        >
        <Image
          src={iconRec}
          alt="icone de video cam"
          class="w-8 animate-pulse hover:box-border"
        />
      </div>
    </li>
  </ul>
  <SocialLinks />
  <Image
    class={`
      fixed right-20 top-1 border border-zinc-800 w-24
      max-lg:right-6
    `}
    src={logo}
    alt="imagem da logo do site"
  />
</header>
