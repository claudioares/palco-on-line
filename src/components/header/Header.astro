---
import { Image } from "astro:assets";
import logo from "../../assets/palco.png";
---

<script>
  document.getElementById("buttonNavMenu")?.addEventListener("click", () => {
    const navManu = document.getElementById("navManu");

    navManu?.classList.toggle("max-lg:max-h-0");
    navManu?.classList.toggle("max-lg:max-h-screen");
    navManu?.classList.toggle("opacity-0");
    navManu?.classList.toggle("opacity-100");
  });
</script>

<header class="flex w-full h-20 bg-black px-36 opacity-85 z-20 fixed">
  <button
    id="buttonNavMenu"
    class="fixed top-5 left-10 z-30 text-white bg-orange-700 w-32 h-10 rounded-lg lg:hidden"
    >Menu</button
  >
  <ul
    id="navManu"
    class={`
      flex flex-1 items-center gap-16 h-full text-white text-lg
      max-lg:fixed max-lg:z-20 max-lg:w-full max-lg:max-h-0 max-lg:bg-black left-0 max-lg:flex max-lg:flex-col max-lg:justify-center
      max-lg:opacity-90 max-lg:gap-10 max-lg:overflow-hidden max-lg:transition-all duration-1000
    `}
  >
    <li><a class="hover:text-slate-200" href="#">Home</a></li>
    <li><a class="hover:text-slate-200" href="#">Ao vivo</a></li>
  </ul>
  <Image
    class={`
      fixed right-20 top-1 border border-zinc-800 w-24
      max-lg:right-6
    `}
    src={logo}
    alt="imagem da logo do site"
  />
</header>
